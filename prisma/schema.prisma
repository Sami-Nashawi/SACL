generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (host contains -pooler), used by the running app
  directUrl = env("DIRECT_URL") // Neon direct connection, used by prisma db push / migrate
}

// One row = one line from a DXF. A layout is all the rows with the same project name.
// points is [[east, north], ...] in UTM metres.
model Cable {
  id        String   @id @default(cuid())
  name      String
  project   String   @default("") // the layout this line belongs to
  layer     String   @default("") // kind of line, e.g. ETC, IRR, PW
  color     String   @default("") // map colour like #8e44ad; empty means automatic
  zone      Int      @default(40)
  points    Json
  lengthM   Float
  minE      Float
  maxE      Float
  minN      Float
  maxN      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([project, name])
  @@index([project])
}

enum Role {
  ADMIN // adds and deletes cables, manages users
  ENGINEER // finds cables on site
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique // always stored in lower case
  passwordHash       String
  role               Role      @default(ENGINEER)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // true after an admin sets or resets the password
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
